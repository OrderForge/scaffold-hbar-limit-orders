{
  "name": "limit-orders",
  "description": "Add non-custodial limit orders from SaucerSwap's order book to any Hedera app, with every fill verified on-chain against what you signed.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": [
        "nextjs-app"
      ],
      "solidityFramework": [
        "hardhat"
      ]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "hardhat"
    },
    "outro": {
      "sections": [
        {
          "steps": [
            {
              "text": "Market data works with no wallet, no API key and no deployed contract: run the frontend and open /markets."
            }
          ]
        },
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "label": "Copy the env files",
              "text": "packages/nextjs/.env.example \u2192 packages/nextjs/.env, packages/hardhat/.env.example \u2192 packages/hardhat/.env"
            },
            {
              "label": "Generate or import a deployer account (only needed for on-chain steps)",
              "command": "{run:hardhat:account:generate}"
            },
            {
              "label": "Fund the account with testnet HBAR",
              "url": "https://portal.hedera.com/faucet"
            },
            {
              "label": "Create the HCS order-intent journal topic",
              "command": "yarn clob:bootstrap --network hederaTestnet"
            },
            {
              "text": "SaucerSwap V3 Orderbook API docs:",
              "url": "https://docs.saucerswap.finance/api-reference/orderbook/overview"
            }
          ]
        }
      ]
    }
  }
}