{
  "name": "limit-orders",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/hardhat",
      "packages/nextjs"
    ]
  },
  "scripts": {
    "clob:bootstrap": "yarn workspace @sh/hardhat clob:bootstrap",
    "clob:demo": "yarn workspace @sh/hardhat clob:demo",
    "clob:shots": "yarn workspace @sh/hardhat clob:shots",
    "clob:doctor": "yarn workspace @sh/hardhat clob:doctor",
    "clob:fund": "yarn workspace @sh/hardhat clob:fund",
    "clob:status": "yarn workspace @sh/hardhat clob:status",
    "format": "yarn next:format && yarn hardhat:format",
    "hardhat:account": "yarn workspace @sh/hardhat account",
    "hardhat:account:generate": "yarn workspace @sh/hardhat account:generate",
    "hardhat:account:import": "yarn workspace @sh/hardhat account:import",
    "hardhat:account:reveal-pk": "yarn workspace @sh/hardhat account:reveal-pk",
    "hardhat:chain": "yarn workspace @sh/hardhat chain",
    "hardhat:check-types": "yarn workspace @sh/hardhat check-types",
    "hardhat:clean": "yarn workspace @sh/hardhat clean",
    "hardhat:compile": "yarn workspace @sh/hardhat compile",
    "hardhat:deploy": "yarn workspace @sh/hardhat deploy",
    "hardhat:flatten": "yarn workspace @sh/hardhat flatten",
    "hardhat:fork": "yarn workspace @sh/hardhat fork",
    "hardhat:format": "yarn workspace @sh/hardhat format",
    "hardhat:lint": "yarn workspace @sh/hardhat lint",
    "hardhat:lint-staged": "yarn workspace @sh/hardhat lint-staged",
    "hardhat:test": "yarn workspace @sh/hardhat test",
    "hardhat:test:forking": "yarn workspace @sh/hardhat test:forking",
    "hardhat:verify": "yarn workspace @sh/hardhat verify",
    "hardhat:verify:mainnet": "yarn workspace @sh/hardhat verify:mainnet",
    "hardhat:verify:testnet": "yarn workspace @sh/hardhat verify:testnet",
    "lint": "yarn next:lint && yarn hardhat:lint && yarn lint:wording",
    "lint-staged": "lint-staged",
    "lint:wording": "node scripts/lint-wording.mjs",
    "next:build": "yarn workspace @sh/nextjs build",
    "next:check-types": "yarn workspace @sh/nextjs check-types",
    "next:dev": "yarn workspace @sh/nextjs dev",
    "next:format": "yarn workspace @sh/nextjs format",
    "next:lint": "yarn workspace @sh/nextjs lint",
    "next:serve": "yarn workspace @sh/nextjs serve",
    "next:start": "yarn workspace @sh/nextjs start",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "test:clob": "yarn workspace @sh/nextjs test:clob"
  },
  "packageManager": "yarn@3.2.3",
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}