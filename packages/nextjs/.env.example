# Wallet
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# SaucerSwap V3 Orderbook API. Market data is public on both networks: no key needed.
# testnet (default) | mainnet
NEXT_PUBLIC_CLOB_NETWORK=testnet
# Override the API base only if you proxy it; leave blank to use the network default.
NEXT_PUBLIC_CLOB_API_URL=
NEXT_PUBLIC_MIRROR_URL=
NEXT_PUBLIC_HASHSCAN_URL=
# Market opened by default.
NEXT_PUBLIC_DEFAULT_ORDERBOOK_ID=3

# HCS order-intent journal. Create the topic with `yarn clob:bootstrap`.
NEXT_PUBLIC_JOURNAL_TOPIC_ID=
# Server-side only — never prefix the operator key with NEXT_PUBLIC_.
JOURNAL_TOPIC_ID=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_NETWORK=testnet
